<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169</NoWarn>
    <AssemblyName>trapcard-check</AssemblyName>
    <RootNamespace>TrapCardCheck</RootNamespace>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The REAL state machine Unity runs, not a copy. A copy would drift, and
         a test of a copy proves nothing about what ships. Same reasoning as
         tools/collision-check. -->
    <Compile Include="../../Unity/TRP23/Assets/Core/TrapCardState.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
