<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169</NoWarn>
    <!-- Compile the same branch the project actually runs. -->
    <DefineConstants>ENABLE_INPUT_SYSTEM</DefineConstants>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/Auth/AuthModels.cs" />
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/Auth/IAuthService.cs" />
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/Auth/HttpAuthService.cs" />
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/Auth/MockAuthService.cs" />
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/SceneFlow.cs" />
    <!-- Globbed, not listed. A new script under World/Scripts is checked the
         moment it exists; an explicit list silently skips it, which is the one
         thing this project has been bitten by often enough to design out.
         Editor/ is excluded: it needs UnityEditor, which is not stubbed. -->
    <Compile Include="../../Unity/TRP23/Assets/World/Scripts/*.cs" />
  </ItemGroup>
</Project>
