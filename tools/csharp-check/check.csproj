<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169</NoWarn>
    <!-- Compile the same branch the project actually runs. -->
    <DefineConstants>ENABLE_INPUT_SYSTEM</DefineConstants>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <!-- Globbed for the same reason as World/Scripts: a new file here was
         silently unchecked until somebody noticed. -->
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/Auth/*.cs" />
    <!-- Pure logic, no engine surface — so it is checked here rather than left
         to the editor. CaseFileService above depends on it. -->
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/CaseFile/*.cs" />
    <Compile Include="../../Unity/TRP23/Assets/UI/Scripts/SceneFlow.cs" />
    <!-- Globbed, not listed. A new script under World/Scripts is checked the
         moment it exists; an explicit list silently skips it, which is the one
         thing this project has been bitten by often enough to design out.
         Editor/ is excluded: it needs UnityEditor, which is not stubbed. -->
    <Compile Include="../../Unity/TRP23/Assets/World/Scripts/*.cs" />
  </ItemGroup>
</Project>
