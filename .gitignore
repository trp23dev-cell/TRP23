# Dependencies (installed fresh at build time via npm + package-lock.json)
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# pnpm artifacts — this project builds with npm; a committed pnpm-lock.yaml /
# pnpm-workspace.yaml makes Nixpacks/Railway pick pnpm and fail the build.
pnpm-lock.yaml
pnpm-workspace.yaml

# The database is NOT tracked. It holds player accounts — emails, phone
# numbers and password hashes — and this repository is public. It is also
# runtime state: committing it means every deploy resets live players back to
# whatever was last committed.
#
# The MAP is the one thing in there that has to ship, and it travels separately
# as server/storage/map-export.json.gz, which the server imports on boot.
server/storage/*.db
server/storage/*.db-wal
server/storage/*.db-shm

# Signing material and API keys. An Apple .p8 cannot be re-downloaded and
# grants App Store Connect / push access, so it must never be in the tree.
*.p8
*.p12
*.keystore
*.jks
*.mobileprovision
*.cer
*.csr
*.pem
*.key

# Local env files (keep the *.example templates)
.env
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
*.log

# Unity project/solution files. Regenerated by the editor from the .asmdef and
# package set, differ per machine, and — because they make Nixpacks detect a
# .NET project and run `dotnet restore` — they broke the Railway build, which
# is why nixpacks.toml has to force the Node provider.
Unity/**/*.csproj
Unity/**/*.sln
Unity/**/*.slnx
Unity/**/*.user

# Generated handoff package for the Unity client (npm run export:unity)
exports/

# Unity generated folders (matches Unity/... and nested Unity/<project>/...)
Unity/**/[Ll]ibrary/
Unity/**/[Tt]emp/
Unity/**/[Oo]bj/
Unity/**/[Bb]uild/
Unity/**/[Bb]uilds/
Unity/**/[Ll]ogs/
Unity/**/[Uu]ser[Ss]ettings/
Unity/**/[Mm]emoryCaptures/
Unity/**/[Rr]ecordings/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
tools/csharp-check/obj/
tools/csharp-check/bin/
tools/collision-check/obj/
tools/collision-check/bin/

# Unity Starter Assets (Asset Store, Unity Companion License).
#
# NOT committed, and that is a judgement call worth knowing about: it is 86 MB
# of mostly character art, and git keeps every version of it for ever, so this
# is the one decision here that cannot be undone by a later commit. Reimport it
# from the Asset Store and run TRAP > Build World Test Scene again.
#
# Nothing breaks without it: the setup script checks for the prefab and falls
# back to the free camera, saying so in the console. If you would rather a
# fresh checkout just worked, delete these two lines and commit it -- that
# direction is easy, the other one is not.
Unity/**/Assets/StarterAssets/
Unity/**/Assets/StarterAssets.meta

# ...except the one script we edited. It carries the first-person mode, and an
# ignored folder is a very quiet place for a change to disappear.
!Unity/**/Assets/StarterAssets/ThirdPersonController/Scripts/ThirdPersonController.cs
!Unity/**/Assets/StarterAssets/license.txt
