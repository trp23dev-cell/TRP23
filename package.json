{
  "name": "trap-made-it-phase1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/mockApiServer.js",
    "dev": "vite --host",
    "dev:api": "node server/mockApiServer.js",
    "dev:full": "node server/dev-full.js",
    "validate:rooms": "node scripts/validate-room-assets.mjs",
    "export:unity": "node scripts/export-unity-handoff.mjs",
    "handoff:unity": "npm run validate:rooms && npm run export:unity",
    "test:api": "node scripts/smoke-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:prepare": "npm run build && npm run ios:sync",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:prepare": "npm run build && npm run android:sync",
    "map:build": "node scripts/build-map-tiles.mjs",
    "map:verify": "node scripts/verify-map.mjs",
    "map:export": "node scripts/export-map.mjs",
    "check:repo": "node scripts/check-repo-hygiene.mjs",
    "check:api": "node scripts/check-api-security.mjs",
    "check:trap": "node scripts/check-trap-card.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:materials": "node scripts/check-materials.mjs",
    "check:csharp": "dotnet build tools/csharp-check/Core.csproj -v q --nologo && dotnet build tools/csharp-check/World.csproj -v q --nologo && dotnet build tools/csharp-check/UI.csproj -v q --nologo",
    "check:world": "dotnet run --project tools/collision-check/check.csproj -c Release -v q --nologo"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.2",
    "better-sqlite3": "^11.8.1",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/android": "^7.4.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.0"
  }
}
